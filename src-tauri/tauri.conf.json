{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waybound",
  "version": "0.1.5",
  "identifier": "dev.waybound",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Waybound",
        "width": 1280,
        "height": 800,
        "visible": false,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FrengkyS1/waybound/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMjg4MDhBMURFQTlERDkKUldUWm5lb2Rpb0FvZ0x0SjNHdXN4aEtzcjlNbXBFNnVUaGVCOHJudWRkVWNROTBXOGMwVkdoVk8K"
    }
  }
}
